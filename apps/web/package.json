{
  "name": "@rajgruha/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "deploy": "vite build && wrangler deploy",
    "preview:cf": "vite build && wrangler dev -c dist/server/wrangler.json -c ../api/wrangler.jsonc --persist-to ../api/.wrangler/state --port 8788"
  },
  "dependencies": {
    "@embedpdf/engines": "^2.15.1",
    "@embedpdf/models": "^2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/react-pdf-viewer": "^2.15.1",
    "@rajgruha/shared": "workspace:*",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.169.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "epubjs": "^0.3.93",
    "fuse.js": "^7.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "sass": "^1.107.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.156.1"
  }
}
